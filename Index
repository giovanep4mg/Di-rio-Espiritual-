<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diário Espiritual - Método Pe. Jonas Abib</title>
    <!-- Tailwind CSS para estilização moderna e limpa -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-serif-custom {
            font-family: 'Lora', serif;
        }
    </style>
</head>
<body class="bg-[#FBF9F5] text-stone-800 min-h-screen flex flex-col transition-colors duration-300" id="bodyElement">

    <!-- Cabeçalho -->
    <header class="bg-white/80 backdrop-blur-md border-b border-stone-200 sticky top-0 z-50">
        <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-full bg-amber-800 text-white flex items-center justify-center font-serif-custom font-bold text-lg shadow-sm">
                    ✝
                </div>
                <div>
                    <h1 class="font-serif-custom text-xl font-bold text-stone-900 tracking-tight">Diário Espiritual</h1>
                    <p class="text-xs text-stone-500">Baseado no método do Pe. Jonas Abib</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-2">
                <button onclick="mudarAba('novo')" id="btnNovo" class="px-4 py-2 text-sm font-medium rounded-lg bg-amber-900 text-white shadow-sm transition-all hover:bg-amber-950">
                    ✏️ Novo Registro
                </button>
                <button onclick="mudarAba('historico')" id="btnHistorico" class="px-4 py-2 text-sm font-medium rounded-lg bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all">
                    📚 Histórico
                </button>
            </div>
        </div>
    </header>

    <!-- Conteúdo Principal -->
    <main class="flex-grow max-w-4xl w-full mx-auto p-4 sm:p-6">

        <!-- ABA 1: NOVO REGISTRO -->
        <section id="abaNovo" class="space-y-6">
            <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-stone-200 space-y-6">
                
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-stone-100">
                    <div>
                        <h2 class="font-serif-custom text-2xl font-bold text-stone-900">Leitura Diária</h2>
                        <p class="text-sm text-stone-500">Registre os frutos da sua meditação na Palavra de Deus.</p>
                    </div>
                    <div>
                        <label for="dataRegistro" class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Data</label>
                        <input type="date" id="dataRegistro" class="bg-stone-50 border border-stone-200 text-stone-800 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-amber-800 outline-none">
                    </div>
                </div>

                <div class="space-y-4">
                    <!-- Trecho Lido -->
                    <div>
                        <label for="trechoLido" class="block text-sm font-semibold text-stone-700 mb-1">📖 Trecho Bíblico Lido</label>
                        <input type="text" id="trechoLido" placeholder="Ex: João 3, 1-16 / Salmo 23" class="w-full bg-stone-50 border border-stone-200 rounded-lg px-4 py-3 text-stone-800 placeholder-stone-400 focus:ring-2 focus:ring-amber-800 outline-none">
                    </div>

                    <!-- A Promessa -->
                    <div class="bg-amber-50/50 border border-amber-200/60 rounded-xl p-4 sm:p-5 space-y-2">
                        <label for="promessa" class="block text-sm font-bold text-amber-900">1. A Promessa — <span class="font-normal text-xs text-amber-800">O que Deus prometeu para mim neste trecho?</span></label>
                        <textarea id="promessa" rows="3" placeholder="Escreva aqui a promessa de Deus..." class="w-full bg-white border border-amber-200 rounded-lg p-3 text-stone-800 placeholder-stone-400 focus:ring-2 focus:ring-amber-800 outline-none resize-y"></textarea>
                    </div>

                    <!-- A Ordem -->
                    <div class="bg-emerald-50/50 border border-emerald-200/60 rounded-xl p-4 sm:p-5 space-y-2">
                        <label for="ordem" class="block text-sm font-bold text-emerald-900">2. A Ordem — <span class="font-normal text-xs text-emerald-800">Qual ordem ou mandamento Deus está me dando hoje?</span></label>
                        <textarea id="ordem" rows="3" placeholder="Escreva aqui o que Deus pede que você pratique..." class="w-full bg-white border border-emerald-200 rounded-lg p-3 text-stone-800 placeholder-stone-400 focus:ring-2 focus:ring-emerald-700 outline-none resize-y"></textarea>
                    </div>

                    <!-- O Princípio Eterno -->
                    <div class="bg-sky-50/50 border border-sky-200/60 rounded-xl p-4 sm:p-5 space-y-2">
                        <label for="principio" class="block text-sm font-bold text-sky-900">3. O Princípio Eterno — <span class="font-normal text-xs text-sky-800">O que este texto me revela sobre o caráter de Deus e Seu Reino?</span></label>
                        <textarea id="principio" rows="3" placeholder="Escreva aqui a verdade imutável aprendida..." class="w-full bg-white border border-sky-200 rounded-lg p-3 text-stone-800 placeholder-stone-400 focus:ring-2 focus:ring-sky-700 outline-none resize-y"></textarea>
                    </div>

                    <!-- Notas de Oração -->
                    <div>
                        <label for="notasOracao" class="block text-sm font-semibold text-stone-700 mb-1">🙏 Notas de Oração / Intenções Livres</label>
                        <textarea id="notasOracao" rows="3" placeholder="Desabafo, pedidos de oração ou conversa íntima com Deus..." class="w-full bg-stone-50 border border-stone-200 rounded-lg p-3 text-stone-800 placeholder-stone-400 focus:ring-2 focus:ring-amber-800 outline-none resize-y"></textarea>
                    </div>
                </div>

                <!-- Botão Salvar -->
                <div class="pt-4 flex justify-end">
                    <button onclick="salvarRegistro()" class="w-full sm:w-auto px-8 py-3 bg-amber-900 hover:bg-amber-950 text-white font-medium rounded-xl shadow-md transition-all flex items-center justify-center space-x-2">
                        <span>💾 Salvar Diário Espiritual</span>
                    </button>
                </div>

            </div>
        </section>

        <!-- ABA 2: HISTÓRICO -->
        <section id="abaHistorico" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-stone-200 space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
                    <h2 class="font-serif-custom text-2xl font-bold text-stone-900">Seu Histórico Espiritual</h2>
                    <input type="text" id="filtroBusca" oninput="renderizarHistorico()" placeholder="Buscar por trecho ou data..." class="w-full sm:w-64 bg-stone-50 border border-stone-200 text-stone-800 text-sm rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-amber-800">
                </div>

                <div id="listaHistorico" class="space-y-4 pt-2">
                    <!-- Os registros salvos aparecerão aqui dinamicamente -->
                </div>
            </div>
        </section>

    </main>

    <!-- Rodapé -->
    <footer class="text-center py-6 text-xs text-stone-400 border-t border-stone-200 mt-auto">
        Criado para aprofundar a intimidade com a Palavra de Deus • Diário Espiritual Offline
    </footer>

    <!-- Script de Funcionamento -->
    <script>
        // Data atual preenchida por padrão
        document.getElementById('dataRegistro').valueAsDate = new Date();

        function mudarAba(aba) {
            const btnNovo = document.getElementById('btnNovo');
            const btnHistorico = document.getElementById('btnHistorico');
            const abaNovo = document.getElementById('abaNovo');
            const abaHistorico = document.getElementById('abaHistorico');

            if (aba === 'novo') {
                btnNovo.className = "px-4 py-2 text-sm font-medium rounded-lg bg-amber-900 text-white shadow-sm transition-all hover:bg-amber-950";
                btnHistorico.className = "px-4 py-2 text-sm font-medium rounded-lg bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all";
                abaNovo.classList.remove('hidden');
                abaHistorico.classList.add('hidden');
            } else {
                btnHistorico.className = "px-4 py-2 text-sm font-medium rounded-lg bg-amber-900 text-white shadow-sm transition-all hover:bg-amber-950";
                btnNovo.className = "px-4 py-2 text-sm font-medium rounded-lg bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all";
                abaHistorico.classList.remove('hidden');
                abaNovo.classList.add('hidden');
                renderizarHistorico();
            }
        }

        function salvarRegistro() {
            const data = document.getElementById('dataRegistro').value;
            const trecho = document.getElementById('trechoLido').value;
            const promessa = document.getElementById('promessa').value;
            const ordem = document.getElementById('ordem').value;
            const principio = document.getElementById('principio').value;
            const notas = document.getElementById('notasOracao').value;

            if (!data || !trecho) {
                alert('Por favor, preencha pelo menos a Data e o Trecho Lido.');
                return;
            }

            const novoRegistro = {
                id: Date.now(),
                data,
                trecho,
                promessa,
                ordem,
                principio,
                notas
            };

            let registros = JSON.parse(localStorage.getItem('diario_espiritual')) || [];
            registros.unshift(novoRegistro); // Adiciona no início
            localStorage.setItem('diario_espiritual', JSON.stringify(registros));

            alert('Diário salvo com sucesso!');
            
            // Limpa campos principais
            document.getElementById('trechoLido').value = '';
            document.getElementById('promessa').value = '';
            document.getElementById('ordem').value = '';
            document.getElementById('principio').value = '';
            document.getElementById('notasOracao').value = '';
            
            mudarAba('historico');
        }

        function renderizarHistorico() {
            const lista = document.getElementById('listaHistorico');
            const termo = document.getElementById('filtroBusca').value.toLowerCase();
            let registros = JSON.parse(localStorage.getItem('diario_espiritual')) || [];

            if (registros.length === 0) {
                lista.innerHTML = `<p class="text-stone-400 text-center py-8">Nenhum registro encontrado ainda. Comece hoje preenchendo seu primeiro diário!</p>`;
                return;
            }

            if (termo) {
                registros = registros.filter(r => r.trecho.toLowerCase().includes(termo) || r.data.includes(termo));
            }

            lista.innerHTML = registros.map(r => `
                <div class="border border-stone-200 rounded-xl p-5 bg-stone-50/50 space-y-3">
                    <div class="flex justify-between items-center border-b border-stone-200 pb-3">
                        <div>
                            <span class="text-xs font-semibold px-2.5 py-1 bg-amber-100 text-amber-900 rounded-md">📅 ${r.data.split('-').reverse().join('/')}</span>
                            <h3 class="font-serif-custom font-bold text-lg text-stone-800 mt-1">📖 ${r.trecho}</h3>
                        </div>
                        <button onclick="excluirRegistro(${r.id})" class="text-xs text-red-500 hover:text-red-700 font-medium px-2 py-1 bg-white border border-red-100 rounded-md shadow-xs">Excluir</button>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm pt-1">
                        <div class="bg-amber-50/70 p-3 rounded-lg border border-amber-100">
                            <strong class="block text-amber-900 text-xs uppercase mb-1">A Promessa</strong>
                            <p class="text-stone-700">${r.promessa || 'N/A'}</p>
                        </div>
                        <div class="bg-emerald-50/70 p-3 rounded-lg border border-emerald-100">
                            <strong class="block text-emerald-900 text-xs uppercase mb-1">A Ordem</strong>
                            <p class="text-stone-700">${r.ordem || 'N/A'}</p>
                        </div>
                        <div class="bg-sky-50/70 p-3 rounded-lg border border-sky-100">
                            <strong class="block text-sky-900 text-xs uppercase mb-1">Princípio Eterno</strong>
                            <p class="text-stone-700">${r.principio || 'N/A'}</p>
                        </div>
                    </div>
                    ${r.notas ? `<div class="text-xs text-stone-500 bg-white p-2.5 rounded-md border border-stone-100"><strong>Notas:</strong> ${r.notas}</div>` : ''}
                </div>
            `).join('');
        }

        function excluirRegistro(id) {
            if (confirm('Deseja realmente excluir este registro do diário?')) {
                let registros = JSON.parse(localStorage.getItem('diario_espiritual')) || [];
                registros = registros.filter(r => r.id !== id);
                localStorage.setItem('diario_espiritual', JSON.stringify(registros));
                renderizarHistorico();
            }
        }
    </script>
</body>
</html>
